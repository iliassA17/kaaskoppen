# Vul echte waarden uitsluitend privé in Netlify in, met scope Functions.
# Deze voorbeeldwaarden activeren geen betalingen.
FIREBASE_PROJECT_ID=boekingsschema
APP_URL=https://boekingschema.netlify.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
# Zet dit pas op true wanneer de productie-inrichting en webhook gereed zijn.
# Gebruik op productie uitsluitend een livesleutel, nooit een testsleutel.
BILLING_LIVE_ENABLED=false
