# Vul echte waarden uitsluitend privé in Netlify in, met scope Functions.
# Deze voorbeeldwaarden activeren geen betalingen.
FIREBASE_PROJECT_ID=boekingsschema
APP_URL=https://boekingschema.netlify.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
